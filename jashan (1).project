{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"private_outputs":true,"provenance":[],"authorship_tag":"ABX9TyMIs5jPj/kwlUoyvzofIUaG"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["# Install Gradio\n","!pip install -q gradio\n","\n","import gradio as gr\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","def ecommerce_analysis(file):\n","\n","    # Read dataset\n","    df = pd.read_csv(\"/content/ecommerce_1000_records.csv (1).csv\")\n","\n","    # ---------------- Dataset Summary ----------------\n","    summary = f\"\"\"\n","Dataset Shape : {df.shape}\n","\n","Missing Values :\n","{df.isnull().sum()}\n","\n","Duplicate Records : {df.duplicated().sum()}\n","\"\"\"\n","\n","    # ---------------- Revenue Graph ----------------\n","    plt.figure(figsize=(8,5))\n","\n","    revenue_col = \"revenue\" if \"revenue\" in df.columns else \"Purchase_Amount\"\n","\n","    sns.histplot(df[revenue_col], bins=20, kde=True)\n","\n","    plt.title(\"Revenue Distribution\")\n","\n","    revenue_graph = \"revenue.png\"\n","\n","    plt.savefig(revenue_graph)\n","\n","    plt.close()\n","\n","    # ---------------- Device Graph ----------------\n","    plt.figure(figsize=(7,5))\n","\n","    device_col = \"device\" if \"device\" in df.columns else \"Device\"\n","\n","    sns.countplot(data=df, x=device_col)\n","\n","    plt.title(\"Device Analysis\")\n","\n","    device_graph = \"device.png\"\n","\n","    plt.savefig(device_graph)\n","\n","    plt.close()\n","\n","    # ---------------- Category Graph ----------------\n","    plt.figure(figsize=(8,5))\n","\n","    category_col = \"category\" if \"category\" in df.columns else \"Product_Category\"\n","\n","    sns.countplot(data=df, x=category_col)\n","\n","    plt.xticks(rotation=30)\n","\n","    plt.title(\"Product Category\")\n","\n","    category_graph = \"category.png\"\n","\n","    plt.savefig(category_graph)\n","\n","    plt.close()\n","\n","    return summary, revenue_graph, device_graph, category_graph\n","\n","\n","demo = gr.Interface(\n","    fn=ecommerce_analysis,\n","\n","    inputs=gr.File(label=\"/content/ecommerce_1000_records.csv (1).csv\"),\n","\n","    outputs=[\n","        gr.Textbox(label=\"Dataset Summary\"),\n","        gr.Image(label=\"Revenue Distribution\"),\n","        gr.Image(label=\"Device Analysis\"),\n","        gr.Image(label=\"Category Analysis\")\n","    ],\n","\n","    title=\"E-Commerce Customer Purchase Funnel Analysis\",\n","\n","    description=\"/content/ecommerce_1000_records.csv (1).csv\"\n",")\n","\n","demo.launch()"],"metadata":{"id":"eFjL5Ql1IDco"},"execution_count":null,"outputs":[]}]}